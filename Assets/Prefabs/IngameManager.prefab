--- !u!114 &2195213065425760718
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3716992013595653786}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 635152cfad9bb8a4ab500266886af2a5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Intro
  dialog:
  - characterName: Player
    dialogText: 'Deep within a forest, far from civilization, lives an alchemist.

'
  - characterName: Player
    dialogText: Once shunned by his peers, he never lost sight of his dream.
  - characterName: Player
    dialogText: "As a child, he roamed the wilds. Collecting leaves, insects, and
      even the remains of small animals. \n\nHe could feel the hidden energy within
      them. \nOver time, he learned to harness these essences, crafting strange contraptions
      to push the limits of possibility."
  - characterName: Player
    dialogText: 'Now, years later, the woods have changed.

      Monsters grow stronger,
      their presence heavier with each passing night.'
  - characterName: Player
    dialogText: 'As darkness closes in and distant footsteps echo through the woods...

      ...
      The forest holds its breath. Then, from the shadows... the first creatures
      emerge.

'
  dialogWindow: {fileID: 9108948567383507396}
  characterNameText: {fileID: 4876098880417805171}
  dialogText: {fileID: 6059037411253632684}
  blackScreen: {fileID: 8246664057316569440}
  fadeOutTime: 2
